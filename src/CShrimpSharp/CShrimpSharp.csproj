<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CShrimpSharp</RootNamespace>
    <AssemblyName>CShrimpSharp</AssemblyName>
    <PackageId>CShrimpSharp</PackageId>
    <Title>CShrimpSharp</Title>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>RelFost</Authors>
    <Company>CShrimp</Company>
    <Description>Verse-inspired explicit failure handling, structured concurrency, and compensating transactions for C# and .NET.</Description>
    <PackageTags>verse;csharp;dotnet;result;option;validation;structured-concurrency;transactions;async</PackageTags>
    <PackageProjectUrl>https://github.com/RelFost/CShrimpSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RelFost/CShrimpSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
